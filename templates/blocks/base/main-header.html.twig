<header class="header">
    <div class="container">
        <nav class="nav">
            <div class="nav__logo">
                <a href="/">FinModelPro</a>
            </div>
            <div class="nav__elems">
                {% if app.user %}
                    <span class="nav__user">{{ app.user.userIdentifier }}</span>
                    <form method="post" action="{{ path('app_logout') }}" class="nav__logout-form">
                        <button class="nav__btn" type="submit">Выйти</button>
                    </form>
                {% else %}
                    <a class="nav__btn nav__btn-link" href="{{ path('app_login') }}">Войти</a>
                {% endif %}
            </div>
        </nav>
    </div>
</header> 
