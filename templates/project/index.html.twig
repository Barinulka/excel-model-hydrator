{% extends 'project.html.twig' %}

{% block title %}Проекты | FinModelPro{% endblock %}
{% block project_page_title %}Мои проекты{% endblock %}

{% set selectedProject = projects|first %}

{% block project_shell_attributes %}data-controller="project-selector"{% endblock %}

{% block project_sidebar %}
    <section class="project-list" aria-label="Список проектов">
        <h2 class="project-list__title">Проекты</h2>
        <p class="project-list__description">Выберите проект, чтобы увидеть краткую информацию и перейти к модели.</p>

        <div class="project-list__items" role="list">
            {% for project in projects %}
                <button
                    type="button"
                    role="listitem"
                    class="project-list__item{{ loop.first ? ' project-list__item_active' : '' }}"
                    data-action="click->project-selector#select"
                    data-project-selector-target="item"
                    data-project-name="{{ project.name|e('html_attr') }}"
                    data-project-description="{{ project.description|e('html_attr') }}"
                    data-project-updated="{{ project.updatedAt|e('html_attr') }}"
                    data-project-scenarios="{{ project.scenariosCount }}"
                    data-project-period="{{ project.period|e('html_attr') }}"
                    data-project-model-url="{{ project.modelUrl|e('html_attr') }}"
                >
                    <span class="project-list__name">{{ project.name }}</span>
                    <span class="project-list__meta">{{ project.updatedAt }}</span>
                </button>
            {% endfor %}
        </div>
    </section>
{% endblock %}

{% block body %}
    <section class="project-workspace" aria-labelledby="project-workspace-title">
        <header class="project-workspace__header">
            <div>
                <h2 id="project-workspace-title" class="project-workspace__title">Стартовая страница проекта</h2>
                <p class="project-workspace__lead">Создавайте новые проекты, выбирайте существующие и переходите в модель.</p>
            </div>
            <a class="project-create-btn" href="{{ path('app_add_project') }}">Создать проект</a>
        </header>

        {% if selectedProject %}
            {{ include('project/blocks/_project_summary_article.html.twig', { project: selectedProject }) }}
        {% else %}
            {{ include('project/blocks/_project_empty_article.html.twig') }}
        {% endif %}
    </section>
{% endblock %}
