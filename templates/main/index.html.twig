{% extends 'base.html.twig' %}

{% block title %}FinModelPro{% endblock %}

{% block body %}
    <div class="container">
        <h1>Главная страница</h1>
        {% if app.user %}
            <p>Вы вошли как <strong>{{ app.user.userIdentifier }}</strong>.</p>
        {% else %}
            <p>Вы не авторизованы. <a href="{{ path('app_login') }}">Войти</a> или <a href="{{ path('app_register') }}">зарегистрироваться</a>.</p>
        {% endif %}
    </div>
{% endblock %}
