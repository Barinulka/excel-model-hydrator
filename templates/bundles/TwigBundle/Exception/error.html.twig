<!DOCTYPE html>
<html lang="ru">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Ошибка {{ status_code }}{% endblock %}</title>
        <style>
            :root {
                color-scheme: light;
                --bg-1: #f3f6fd;
                --bg-2: #e9eef8;
                --card-bg: #ffffff;
                --text-main: #122138;
                --text-sub: #4f5f79;
                --accent: #2d5bba;
                --accent-hover: #244b97;
                --accent-soft: #e8eefb;
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                font-family: "Segoe UI", Arial, sans-serif;
                color: var(--text-main);
                background: linear-gradient(180deg, var(--bg-1) 0%, var(--bg-2) 100%);
                min-height: 100vh;
            }

            .error-page {
                min-height: 100vh;
                display: grid;
                place-items: center;
                padding: 24px;
            }

            .error-card {
                width: min(100%, 560px);
                border-radius: 18px;
                background: var(--card-bg);
                box-shadow: 0 20px 70px rgba(18, 33, 56, 0.18);
                text-align: center;
                padding: 34px 28px;
            }

            .error-code {
                margin: 0;
                font-size: clamp(52px, 9vw, 84px);
                line-height: 1;
                font-weight: 800;
                color: var(--accent);
            }

            .error-title {
                margin: 12px 0 0;
                font-size: clamp(24px, 4vw, 34px);
                line-height: 1.2;
            }

            .error-description {
                margin: 12px auto 0;
                max-width: 45ch;
                color: var(--text-sub);
                line-height: 1.5;
            }

            .error-actions {
                margin-top: 24px;
                display: flex;
                justify-content: center;
                gap: 10px;
                flex-wrap: wrap;
            }

            .error-button {
                height: 42px;
                padding: 0 16px;
                border-radius: 10px;
                border: 0;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                text-decoration: none;
                font-size: 14px;
                font-weight: 700;
                background: var(--accent);
                color: #fff;
            }

            .error-button:hover {
                background: var(--accent-hover);
            }

            .error-button_secondary {
                background: var(--accent-soft);
                color: var(--accent);
            }

            .error-button_secondary:hover {
                background: #dbe6fb;
            }
        </style>
    </head>
    <body>
        <main class="error-page">
            <section class="error-card">
                <p class="error-code">{{ status_code }}</p>
                <h1 class="error-title">{% block error_title %}Что-то пошло не так{% endblock %}</h1>
                <p class="error-description">{% block error_description %}Произошла ошибка "{{ status_text }}". Попробуйте обновить страницу позже.{% endblock %}</p>
                <div class="error-actions">
                    <a href="{{ path('app_main') }}" class="error-button">На главную</a>
                    {% block error_actions %}{% endblock %}
                </div>
            </section>
        </main>
    </body>
</html>
