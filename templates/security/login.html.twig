{% extends 'base.html.twig' %}

{% block title %}Вход{% endblock %}

{% block header %}{% endblock %}

{% block body %}
    <main class="auth-page">
        <div class="auth-overlay"></div>
        <section class="auth-modal" aria-labelledby="auth-title">
            <h1 id="auth-title" class="auth-title">Вход в аккаунт</h1>

            {% for message in app.flashes('success') %}
                <p class="auth-alert auth-alert_success">{{ message }}</p>
            {% endfor %}

            {% if error %}
                <p class="auth-alert">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}" class="auth-form">
                <label class="auth-label" for="email">Email</label>
                <input
                    id="email"
                    class="auth-input"
                    type="email"
                    name="_username"
                    value="{{ last_username }}"
                    autocomplete="email"
                    required
                    autofocus
                >

                <label class="auth-label" for="password">Пароль</label>
                <input
                    id="password"
                    class="auth-input"
                    type="password"
                    name="_password"
                    autocomplete="current-password"
                    required
                >

                <button type="submit" class="auth-button">Войти</button>
            </form>

            <p class="auth-switch">
                Нет аккаунта?
                <a href="{{ path('app_register') }}">Пройти регистрацию</a>
            </p>
        </section>
    </main>
{% endblock %}
